{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crowd-media",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  // The Worker routes every request (band resolution, /<band>/ page on unclaimed hosts)
  // and hands static paths to ASSETS itself, so routing never depends on whether an
  // asset happens to match.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Upload pipeline (src/api/uploads.ts). Names must match what mp-infra creates.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "crowd-media" }],
  "durable_objects": { "bindings": [{ "name": "COUNTERS", "class_name": "BandCounters" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BandCounters"] }],
  // POST /api/uploads per client IP. namespace_id is unique per account.
  "ratelimits": [{ "name": "UPLOAD_RL", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // HMAC key for upload ids, and the Turnstile widget secret checked on upload init
  // (src/upload/turnstile.ts): `wrangler secret put <NAME>`; locally .dev.vars.
  "secrets": { "required": ["UPLOAD_SIGNING_KEY", "TURNSTILE_SECRET"] }
  // No routes, custom domains, or resource creation here: all Cloudflare resources are
  // Terraform in mp-infra; the bindings above name what it creates.
}
