{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crowd-media",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  // The Worker routes every request (band resolution, /<band>/ page on unclaimed hosts)
  // and hands static paths to ASSETS itself, so routing never depends on whether an
  // asset happens to match.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "upload_source_maps": true
  // No routes, custom domains, or resource creation here: all Cloudflare resources are
  // Terraform in mp-infra. Bindings (R2, DO) are added by name once mp-infra creates them.
}
