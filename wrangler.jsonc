{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crowd-media",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  // Page is asset-served; only /api/* reaches the Worker. Everything else the Worker
  // receives (none, by construction) falls through to ASSETS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true
  // No routes, custom domains, or resource creation here: all Cloudflare resources are
  // Terraform in mp-infra. Bindings (R2, DO) are added by name once mp-infra creates them.
}
